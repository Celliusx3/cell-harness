{
  "llm": {
    "base_url": "https://api.ilmu.ai/v1",
    "model": "glm-5.3-flashx",
    "temperature": 1.0,
    "timeout_seconds": 600
  },
  "sessions": {
    "root": "~/.harness/sessions"
  },
  "skills": {
    "roots": [
      ".agents/skills",
      "~/.agents/skills"
    ],
    "editable": "~/.agents/skills"
  },
  "web": {
    "public_url": ""
  },
  "code": {
    "deno_path": "deno",
    "timeout_seconds": 600
  },
  "compaction": {
    "context_tokens": null
  },
  "approval": {
    "tools": ["skill_save", "skill_delete", "skill_write_file", "bot_create", "fetch_with_secret"],
    "grants_path": "~/.harness/approvals.json"
  },
  "bots": {
    "path": "~/.harness/bots.json"
  },
  "secrets": {
    "path": "~/.harness/secrets.json"
  },
  "files": {
    "root": "~/.harness/files",
    "max_bytes": 209715200
  },
  "mcp": {
    "servers": {
      "computer": {
        "command": "uv",
        "args": [
          "run",
          "--quiet",
          "--project",
          "../mcp-servers/computer",
          "computer"
        ],
        "required": true,
        "env": {
          "COMPUTER_ENGINE": "microsandbox",
          "COMPUTER_IDLE_MINUTES": "10",
          "COMPUTER_FILES_DIR": "~/.harness/files",
          "COMPUTER_SKILLS_DIRS": "../.agents/skills"
        }
      }
    }
  }
}
