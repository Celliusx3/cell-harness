{
  "llm": {
    "temperature": 1.0,
    "timeout_seconds": 600
  },
  "sessions": {
    "root": "~/.harness/sessions"
  },
  "skills": {
    "roots": [
      ".agents/skills",
      "~/.agents/skills"
    ],
    "editable": "~/.agents/skills"
  },
  "web": {
    "public_url": ""
  },
  "code": {
    "deno_path": "deno",
    "timeout_seconds": 600
  },
  "compaction": {
    "context_tokens": null
  },
  "approval": {
    "tools": ["skill_save", "skill_delete", "skill_write_file", "bot_create", "fetch_with_secret"],
    "grants_path": "~/.harness/approvals.json",
    "default_mode": "ask"
  },
  "bots": {
    "path": "~/.harness/bots.json"
  },
  "schedules": {
    "path": "~/.harness/schedules.json"
  },
  "secrets": {
    "path": "~/.harness/secrets.json"
  },
  "files": {
    "root": "~/.harness/files",
    "max_bytes": 209715200
  },
  "mcp": {
    "path": "~/.harness/mcp.json"
  }
}
