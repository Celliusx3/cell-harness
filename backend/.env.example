# Copy to backend/.env and fill in. Both of these are required with no default —
# a default model is a behavioral choice, and inheriting one silently is the
# "where did this come from?" bug the house rules forbid.
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL=

# Any OpenAI-compatible /chat/completions endpoint: OpenAI, DeepSeek, Together,
# vLLM, Ollama. Defaults to OpenAI.
# HARNESS_LLM_BASE_URL=https://api.openai.com/v1

# Pinned rather than omitted: leaving it unset means inheriting whatever the
# provider currently defaults to, which can change without our code moving.
# HARNESS_LLM_TEMPERATURE=1.0

# Whole-request budget. Bounds a call that may legitimately think for a while,
# so a hung connection surfaces as a failed turn instead of a stuck process.
# HARNESS_LLM_TIMEOUT_SECONDS=600
