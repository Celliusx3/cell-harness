.DS_Store
*.log

# Local settings: same shape as the committed config.json, but holding the API
# key and any machine-specific overrides. The glob covers a `config.local.bak`
# for the same reason the .env one below does.
config.local.json
config.local.*.json
!config.local.example.json

# No .env is used any more (settings are JSON), but keep these ignored: an
# exported key that lands in one should never be one `git add -A` from a commit.
.env
.env.*

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Session logs — the harness's own JSONL output. Durable, machine-local, and
# they contain whatever was said to the model.
sessions/
*.jsonl

# Node — the frontend, from phase 4
node_modules/
dist/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Browser-automation artifacts from manual verification runs.
.playwright-mcp/
