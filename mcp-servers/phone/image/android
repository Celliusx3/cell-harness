#!/usr/bin/env bash
# Runs one command inside Android, as Android's root shell would.
set -euo pipefail
launcher="$(pgrep -o -x unshare || true)"
pid="$([ -n "$launcher" ] && pgrep -o -P "$launcher" || true)"
[ -n "$pid" ] || { echo "android: Android is not running" >&2; exit 1; }
exec nsenter --target "$pid" --mount --pid --ipc --uts --net --root --wd=/ -- /system/bin/sh -c "$*"
