#!/usr/bin/env bash
# On Linux: libkrunfw's kernel.c with Android's binder, plus the source it was built from.
set -euo pipefail

LIBKRUNFW_REPO=https://github.com/superradcompany/libkrunfw.git
LIBKRUNFW_REVISION=56bf194627a07996dc4ce21211fe86ada4c76080

here="$(cd "$(dirname "$0")" && pwd)"
work="${1:?usage: bundle <work folder, on a case-sensitive disk> <output folder>}"
out="${2:?usage: bundle <work folder, on a case-sensitive disk> <output folder>}"

mkdir -p "$work" "$out"
if [ ! -d "$work/.git" ]; then
  git clone --quiet "$LIBKRUNFW_REPO" "$work"
fi
git -C "$work" fetch --quiet origin "$LIBKRUNFW_REVISION"
git -C "$work" checkout --quiet --force "$LIBKRUNFW_REVISION"
cat "$here/config-android" >> "$work/config-libkrunfw_aarch64"

make -C "$work" -j"$(nproc)" kernel.c
cp "$work/kernel.c" "$out/kernel.c"
tar --anchored --exclude ./.git --exclude './linux-*' --exclude ./kernel.c \
  -czf "$out/libkrunfw-source.tar.gz" -C "$work" .
echo "$out/kernel.c"
