#!/usr/bin/env bash
# On a phone `boot` started: measures it idle, installs and drives an APK, and measures it again.
set -euo pipefail

NAME=phone-experiment
SETTLE_SECONDS=60
FIELD_X=300
FIELD_Y=232
TEXT='Hello%sfrom%sCell%sHarness'

msb="${MSB:?set MSB to the msb binary from microsandbox 0.7.13}"
export MSB_HOME="${MSB_HOME:?set it to the folder boot used}"
apk="${1:?usage: drive <apk> <package/activity> <button x> <button y> <output folder>}"
activity="${2:?usage: drive <apk> <package/activity> <button x> <button y> <output folder>}"
button_x="${3:?usage: drive <apk> <package/activity> <button x> <button y> <output folder>}"
button_y="${4:?usage: drive <apk> <package/activity> <button x> <button y> <output folder>}"
out="${5:?usage: drive <apk> <package/activity> <button x> <button y> <output folder>}"
mkdir -p "$out"

android() { "$msb" exec "$NAME" -- /usr/local/bin/android "$@"; }
screenshot() { android "screencap -p" > "$out/$1.png"; echo "drive: $1.png"; }
memory() {
  "$msb" metrics "$NAME" --format json | python3 -I -c '
import json, sys
m = json.load(sys.stdin)
gib = 2**30
print("drive: %s: guest %.2f GiB, on the Mac %.2f GiB" % (
    sys.argv[1], m["memory_bytes"] / gib, m["memory_host_resident_bytes"] / gib))
' "$1"
}

sleep "$SETTLE_SECONDS"
memory idle

android "pm install -S $(stat -f %z "$apk")" < "$apk"
android "am start -W -n $activity" > /dev/null
sleep 2
screenshot opened

android "input tap $FIELD_X $FIELD_Y && input text '$TEXT'"
sleep 1
screenshot typed

android "input tap $button_x $button_y"
sleep 1
screenshot tapped

sleep "$SETTLE_SECONDS"
memory "app open"
